{
  "expo": {
    "name": "Falamigos",
    "slug": "falamigos",
    "scheme": "falamigos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B4F6C",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falamigos.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Falamigos usa o microfone para você gravar sua voz durante os exercícios de fala.",
        "NSMotionUsageDescription": "O Falamigos usa o movimento do telefone para um efeito suave de profundidade na tela.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.falamigos.app",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B4F6C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4F6C",
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "O Falamigos usa o microfone para você gravar sua voz durante os exercícios de fala."
        }
      ],
      "expo-sensors",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/withAndroidReleaseSigning.js"
    ]
  }
}
